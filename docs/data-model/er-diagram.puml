@startuml er-diagram
' Generated by scripts/generate-er-diagram.mjs from the migrated database; edit the migrations, not this file.
!pragma layout smetana
!theme plain
hide circle
hide empty members
skinparam linetype ortho

entity activity_logs {
  id : VARCHAR(36) <<PK>>
  --
  teacherId : VARCHAR(36) NULL <<FK>>
  type : VARCHAR(64)
  entity : VARCHAR(64)
  entityId : VARCHAR(36) NULL
  details : JSON NULL
  createdAt : DATETIME(3)
}

entity answer_sheets {
  id : VARCHAR(36) <<PK>>
  --
  applicationId : VARCHAR(36) <<FK>>
  examVersionId : VARCHAR(36) <<FK>>
  studentId : VARCHAR(36) NULL <<FK>>
  sheetNumber : INT UNSIGNED
  code : VARCHAR(32) <<UK>>
  answerCardVersion : SMALLINT UNSIGNED
}

entity applications {
  id : VARCHAR(36) <<PK>>
  --
  examId : VARCHAR(36) <<FK>>
  classId : VARCHAR(36) <<FK>>
  teacherId : VARCHAR(36) <<FK>>
  status : ENUM('draft','generated','closed')
  pdfUrl : VARCHAR(2048) NULL
  date : DATETIME(3)
  gradesReleased : TINYINT(1)
  createdAt : DATETIME(3)
  updatedAt : DATETIME(3)
}

entity auth_codes {
  id : VARCHAR(36) <<PK>>
  --
  userId : VARCHAR(36) <<FK>>
  purpose : ENUM('PASSWORD_RESET','GOOGLE_SIGN_IN')
  codeHash : CHAR(64) <<UK>>
  expiresAt : DATETIME(3)
  usedAt : DATETIME(3) NULL
  createdAt : DATETIME(3)
}

entity class_enrollments {
  id : VARCHAR(36) <<PK>>
  --
  classId : VARCHAR(36) <<FK>>
  studentId : VARCHAR(36) <<FK>>
  status : ENUM('active','removed')
  enrolledVia : ENUM('teacher','invite_code')
}

entity classes {
  id : VARCHAR(36) <<PK>>
  --
  teacherId : VARCHAR(36) <<FK>>
  name : VARCHAR(120)
  subject : VARCHAR(120)
  term : VARCHAR(40)
  status : ENUM('active','archived')
  inviteCode : VARCHAR(32) <<UK>>
  createdAt : DATETIME(3)
  updatedAt : DATETIME(3)
}

entity correction_discursive_scores {
  correctionId : VARCHAR(36) <<PK>> <<FK>>
  questionId : VARCHAR(36) <<PK>> <<FK>>
  --
  score : DECIMAL(6,2)
}

entity correction_objective_results {
  correctionId : VARCHAR(36) <<PK>> <<FK>>
  questionId : VARCHAR(36) <<PK>> <<FK>>
  --
  correct : TINYINT(1)
  score : DECIMAL(6,2)
  selectedAlternativeId : VARCHAR(36) NULL
}

entity corrections {
  id : VARCHAR(36) <<PK>>
  --
  examVersionId : VARCHAR(36) <<FK>>
  studentId : VARCHAR(36) NULL <<FK>>
  reportedStudentName : VARCHAR(160) NULL
  reportedStudentRegistration : VARCHAR(40) NULL
  totalScore : DECIMAL(7,2)
  notes : TEXT NULL
  confirmedAt : DATETIME(3)
  correctedBy : VARCHAR(36) <<FK>>
  isAutomaticallyAssigned : TINYINT(1)
  clientCorrectionId : VARCHAR(64) <<UK>>
  syncStatus : ENUM('pending','synced','error')
  answerSheetId : VARCHAR(36) <<FK>> <<UK>>
  source : ENUM('IMAGE_UPLOAD','MANUAL')
  status : ENUM('IN_PROGRESS','DONE')
  imageUrl : VARCHAR(2048) NULL
  createdAt : DATETIME(3)
  updatedAt : DATETIME(3)
}

entity exam_assignments {
  id : VARCHAR(36) <<PK>>
  --
  examVersionId : VARCHAR(36) <<FK>>
  studentId : VARCHAR(36) <<FK>>
  qrCodePayload : VARCHAR(512)
}

entity exam_questions {
  examId : VARCHAR(36) <<PK>> <<FK>>
  questionId : VARCHAR(36) <<PK>> <<FK>>
  --
  order : SMALLINT UNSIGNED
  score : DECIMAL(6,2)
  allowShuffleAlternatives : TINYINT(1)
}

entity exam_versions {
  id : VARCHAR(36) <<PK>>
  --
  applicationId : VARCHAR(36) <<FK>>
  versionNumber : SMALLINT UNSIGNED
  shuffleQuestions : TINYINT(1)
  shuffleAlternatives : TINYINT(1)
  withStudentIdentification : TINYINT(1)
  layout : JSON
  answerKeyPublished : TINYINT(1)
  answerKeyPublishedAt : DATETIME(3) NULL
  publicCode : VARCHAR(64) <<UK>>
  qrCodePayload : VARCHAR(512)
}

entity exams {
  id : VARCHAR(36) <<PK>>
  --
  teacherId : VARCHAR(36) <<FK>>
  title : VARCHAR(200)
  status : ENUM('draft','ready','closed')
  description : TEXT
  defaultShuffleQuestions : TINYINT(1)
  defaultShuffleAlternatives : TINYINT(1)
  createdAt : DATETIME(3)
  updatedAt : DATETIME(3)
}

entity question_alternatives {
  questionId : VARCHAR(36) <<PK>> <<FK>>
  id : VARCHAR(36) <<PK>>
  --
  text : TEXT
  position : TINYINT UNSIGNED
}

entity question_tags {
  questionId : VARCHAR(36) <<PK>> <<FK>>
  tag : VARCHAR(80) <<PK>>
}

entity questions {
  id : VARCHAR(36) <<PK>>
  --
  teacherId : VARCHAR(36) <<FK>>
  type : ENUM('objetiva','discursiva')
  statement : TEXT
  correctAlternativeId : VARCHAR(36) NULL
  maxScore : DECIMAL(6,2) NULL
  deletedAt : DATETIME(3) NULL
  allowShuffleAlternatives : TINYINT(1)
  createdAt : DATETIME(3)
  updatedAt : DATETIME(3)
}

entity refresh_tokens {
  id : VARCHAR(36) <<PK>>
  --
  userId : VARCHAR(36) <<FK>>
  tokenHash : CHAR(64) <<UK>>
  deviceInfo : VARCHAR(255) NULL
  issuedAt : DATETIME(3)
  expiresAt : DATETIME(3)
  revokedAt : DATETIME(3) NULL
}

entity students {
  id : VARCHAR(36) <<PK>>
  --
  classId : VARCHAR(36) <<FK>>
  fullName : VARCHAR(160)
  registration : VARCHAR(40)
  email : VARCHAR(512) NULL
  anonymizedAt : DATETIME(3) NULL
  userId : VARCHAR(36) NULL <<FK>>
  removedAt : DATETIME(3) NULL
  createdAt : DATETIME(3)
  updatedAt : DATETIME(3)
}

entity users {
  id : VARCHAR(36) <<PK>>
  --
  role : ENUM('professor','estudante')
  fullName : VARCHAR(160)
  email : VARCHAR(254) <<UK>>
  passwordHash : VARCHAR(255)
  createdAt : DATETIME(3)
  anonymizedAt : DATETIME(3) NULL
  emailVerifiedAt : DATETIME(3) NULL
  updatedAt : DATETIME(3)
}

users |o..o{ activity_logs : teacherId
applications ||..o{ answer_sheets : applicationId
exam_versions ||..o{ answer_sheets : examVersionId
students |o..o{ answer_sheets : studentId
exams ||..o{ applications : examId
classes ||..o{ applications : classId
users ||..o{ applications : teacherId
users ||..o{ auth_codes : userId
classes ||..o{ class_enrollments : classId
users ||..o{ class_enrollments : studentId
users ||..o{ classes : teacherId
corrections ||--o{ correction_discursive_scores : correctionId
questions ||--o{ correction_discursive_scores : questionId
corrections ||--o{ correction_objective_results : correctionId
questions ||--o{ correction_objective_results : questionId
exam_versions ||..o{ corrections : examVersionId
students |o..o{ corrections : studentId
users ||..o{ corrections : correctedBy
answer_sheets ||..o| corrections : answerSheetId
exam_versions ||..o{ exam_assignments : examVersionId
users ||..o{ exam_assignments : studentId
exams ||--o{ exam_questions : examId
questions ||--o{ exam_questions : questionId
applications ||..o{ exam_versions : applicationId
users ||..o{ exams : teacherId
questions ||--o{ question_alternatives : questionId
questions ||--o{ question_tags : questionId
users ||..o{ questions : teacherId
users ||..o{ refresh_tokens : userId
classes ||..o{ students : classId
users |o..o{ students : userId
@enduml
