# Copy to .env for local development. The API does not start without
# DATABASE_URL and DATA_ENCRYPTION_KEY; the other values have defaults.

# development, test or production
NODE_ENV=development

PORT=3000

# Origins allowed to call the API: scheme and host only, comma separated.
# 5173 is the dev server and 4173 the preview where Cypress runs.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# fatal, error, warn, info, debug, trace or silent
LOG_LEVEL=info

# Proxies in front of the API. Locally 1 is harmless; on the host, set it to
# the number of proxies so the client address is read correctly.
TRUST_PROXY_HOPS=1

# MySQL. Locally: `docker compose up -d mysql` at the repository root, then
# `npm run db:migrate --workspace @correctio/api`. The container listens on
# 3307 so it never clashes with a MySQL already installed on the machine.
# Always the Docker database here. Hosted credentials are never saved on a
# machine: a one-off check reads them from .env.<environment>.local, which git
# ignores, deleted right after. Leave out query options such as ?ssl-mode: TLS
# is set by DATABASE_TLS below.
DATABASE_URL=mysql://correctio:correctio@127.0.0.1:3307/correctio

# verify: check the server certificate against DATABASE_CA_CERT (required in
# production). local: still encrypted, accepting the self-signed certificate of
# the Docker MySQL. A plain connection is never made.
DATABASE_TLS=local

# The CA certificate of the hosted database: the whole PEM, including the
# BEGIN CERTIFICATE and END CERTIFICATE lines, on one line with \n for each
# line break. Kept in the secret manager, never in the repository.
DATABASE_CA_CERT=

# 32 random bytes in base64 for the field encryption of the student e-mail.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Kept in the secret manager, never in the repository. The API does not start
# without it; the migrations do not read it, so the deploy migrates without it.
DATA_ENCRYPTION_KEY=

# Signs the access tokens: 32 random bytes or more in base64, generated like
# DATA_ENCRYPTION_KEY above. Required in production. Left empty locally, the API
# picks a random one at each start, which only costs a token refresh.
JWT_SECRET=

# The fixed address of this environment's web app: Google returns to it after
# sign-in, and the password reset e-mail links to it.
PUBLIC_APP_URL=http://localhost:5173

# Sign-in with Google: the Web client of the project's Google Cloud account,
# with http://localhost:5173/api/auth/google/callback among its redirect URIs.
# Set both or neither; without them the Google button ends on an error.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# App password of the project's Gmail, which sends the password reset e-mail.
# Without it the e-mail is written to the API log instead, link included.
GMAIL_APP_PASSWORD=
MAIL_FROM=correctioapp@gmail.com

# Where the API keeps files, such as the PDF of an application. local: a
# folder on disk, FILE_STORAGE_DIR, relative to apps/api and ignored by git.
# firebase: the Cloud Storage bucket of the Firebase project, the only choice
# in production, where hosted-env.ts sets it. FILE_STORAGE_BUCKET names the
# bucket; left empty, the project's default bucket.
FILE_STORAGE=local
FILE_STORAGE_DIR=.files
FILE_STORAGE_BUCKET=

# Server-level URL, without a database name, for the schema test: it creates
# and drops its own throwaway database. Uses the root user of the container.
DATABASE_TEST_URL=mysql://root:root@127.0.0.1:3307
