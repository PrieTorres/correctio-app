{
  "name": "@correctio/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "node build.mjs",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts latest",
    "db:rollback": "tsx --env-file-if-exists=.env src/db/migrate.ts down",
    "db:reset": "tsx --env-file-if-exists=.env src/db/migrate.ts reset"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@correctio/domain": "1.0.0",
    "@correctio/sheet-reader": "^1.0.0",
    "@node-rs/argon2": "^2.2.2",
    "cookie": "^2.0.1",
    "cors": "^2.8.6",
    "dejavu-fonts-ttf": "^2.37.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-slow-down": "^3.1.1",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "kysely": "^0.28.17",
    "mysql2": "^3.24.5",
    "nodemailer": "^10.1.1",
    "pdfkit": "^0.20.2",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "zod": "^4.6.7",
    "zxing-wasm": "^3.1.5"
  }
}
