# Copy to .env.local only to point the web app at an API other than its own
# origin. Left unset, the app calls /api: on Firebase, Hosting forwards it to
# the API function; locally, `npm run dev` and `npm run preview` forward it to
# the API on http://localhost:3000 (`npm run dev:api` at the repository root).
VITE_API_URL=/api
